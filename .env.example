# ============================================================
# RAG Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ---- General ----
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ---- Supabase ----
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret


# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_platform

# ---- Redis (BullMQ requires TCP/TLS, NOT REST) ----
# For Upstash, use the "Node.js (ioredis)" connection string (rediss://...)
REDIS_URL=rediss://default:gQAAAAAAAhR1AAIgcDJkNGIyNzFmZThlNzQ0MGE1YWJhYWZjYjY0NThkMzM2OA@calm-stingray-136309.upstash.io:6379

# (Optional) Upstash REST API - Not used by BullMQ, but can be used for caching
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Qdrant ----
QDRANT_URL=https://1ab96b53-6d78-4940-99cb-946a255e692a.australia-southeast1-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6MDE2MWExYTMtY2U1NC00YmUxLTg5OTctYzY0OWI5NGQzYWNkIn0.GiuXLYublItlP1-4DQR9G2b3tiFPkl52U05rUJNlVVE
QDRANT_COLLECTION_NAME=documents

# ---- LLM Providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=your-gemini-api-key

# LLM Configuration
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_MODEL=gemini-1.5-pro
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# ---- Embedding ----
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_CONCURRENT_BATCHES=3

# ---- Reranker ----
COHERE_API_KEY=
RERANKER_PROVIDER=cohere
RERANKER_MODEL=rerank-v3.5
RERANKER_TOP_N=5

# ---- Storage ----
STORAGE_BUCKET=documents
MAX_FILE_SIZE_MB=100

# ---- Rate Limiting ----
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rag-platform
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3100

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000
