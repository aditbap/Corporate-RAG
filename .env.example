# ============================================================
# RAG Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values (apps/web has its own
# apps/web/.env.local — see the "Web app" section; infra/keycloak/setup-realm.sh
# writes the AUTH_* values for you).
# NEVER commit .env to version control.
# Only variables the code actually reads are listed here.
# ============================================================

# ---- General ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3002
LOG_LEVEL=debug

# ---- Database (PostgreSQL, local via docker-compose, pgvector extension) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_platform

# ---- Redis (local via docker-compose) ----
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3-compatible object storage, local via docker-compose) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# ---- Keycloak (apps/api verifies tokens locally against the realm's JWKS) ----
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=rag-platform

# ---- LLM ----
GEMINI_API_KEY=your-gemini-api-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
LLM_PRIMARY_MODEL=@cf/meta/llama-3-8b-instruct

# ---- Embedding ----
NVIDIA_API_KEY=your-nvidia-api-key
# EMBEDDING_DIMENSIONS must match the vector(N) column in the document_chunks
# migration. Changing the model to one with a different width requires a
# migration + full re-ingest, so keep these two in sync.
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
EMBEDDING_DIMENSIONS=2048
# Fail a stalled embeddings request instead of hanging the caller forever.
EMBEDDING_TIMEOUT_MS=30000

# ---- Reranker ----
COHERE_API_KEY=
RERANKER_MODEL=rerank-v3.5
# Minimum reranker score for a chunk to be used as chat context (lower = more recall, more noise)
RERANK_MIN_SCORE=0.1

# ---- Uploads ----
MAX_FILE_SIZE_MB=100

# ---- OCR (PaddleOCR sidecar, local via docker-compose) ----
OCR_SERVICE_URL=http://localhost:8001

# ---- Virus scanning (ClamAV sidecar, local via docker-compose) ----
# Off by default: clamd takes minutes to warm up on first boot (downloading
# virus definitions) and that shouldn't block local dev. Turn on for production.
ENABLE_VIRUS_SCAN=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---- Limits / workers ----
# Chat requests allowed per user per library per minute.
RATE_LIMIT_CHAT_PER_MINUTE=20
# Uploads (new documents and new versions) per user per library per minute; each starts an embedding job.
RATE_LIMIT_UPLOAD_PER_MINUTE=30
# Concurrent ingestion jobs per worker process.
WORKER_CONCURRENCY=5

# ---- Observability (Langfuse tracing; optional) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3100

# ---- CORS (comma-separated browser origins allowed to call apps/api) ----
CORS_ORIGINS=http://localhost:3000

# ---- Retrieval evaluation (scripts/evaluate-retrieval.ts; optional) ----
# EVAL_API_URL=http://localhost:3002/api/v1
# EVAL_API_TOKEN=a-keycloak-access-token
# EVAL_ORG_ID=the-library-id-the-golden-set-belongs-to

# ---- Web app (put these in apps/web/.env.local) ----
# NEXT_PUBLIC_API_URL is the browser-facing URL of apps/api, including /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1
# Auth.js session secret; `infra/keycloak/setup-realm.sh` generates it.
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_KEYCLOAK_ID=rag-web
AUTH_KEYCLOAK_SECRET=your-keycloak-client-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/rag-platform
