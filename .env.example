# ============================================================
# RAG Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ---- General ----
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ---- Database (PostgreSQL, local via docker-compose, pgvector extension) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_platform

# ---- Redis (local via docker-compose) ----
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3-compatible object storage, local via docker-compose) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# ---- Keycloak (OIDC auth, local via docker-compose) ----
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=rag-platform
KEYCLOAK_CLIENT_ID=rag-web
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

# ---- LLM Providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=your-gemini-api-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# LLM Configuration
LLM_PRIMARY_PROVIDER=cloudflare
LLM_PRIMARY_MODEL=@cf/meta/llama-3-8b-instruct
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# ---- Embedding ----
NVIDIA_API_KEY=your-nvidia-api-key
EMBEDDING_PROVIDER=nvidia
# EMBEDDING_DIMENSIONS must match the vector(N) column in the document_chunks
# migration. Changing the model to one with a different width requires a
# migration + full re-ingest, so keep these two in sync.
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
EMBEDDING_DIMENSIONS=2048
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_CONCURRENT_BATCHES=3
# Fail a stalled embeddings request instead of hanging the caller forever.
EMBEDDING_TIMEOUT_MS=30000

# ---- Reranker ----
COHERE_API_KEY=
RERANKER_PROVIDER=cohere
RERANKER_MODEL=rerank-v3.5
RERANKER_TOP_N=5

# ---- Storage ----
MAX_FILE_SIZE_MB=100

# ---- OCR (PaddleOCR sidecar, local via docker-compose) ----
OCR_SERVICE_URL=http://localhost:8001

# ---- Virus scanning (ClamAV sidecar, local via docker-compose) ----
# Off by default: clamd takes minutes to warm up on first boot (downloading
# virus definitions) and that shouldn't block local dev. Turn on for production.
ENABLE_VIRUS_SCAN=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---- Rate Limiting ----
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rag-platform
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3100

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Web app (apps/web) — Auth.js + Keycloak ----
# NEXT_PUBLIC_API_URL is the browser-facing URL of apps/api.
NEXT_PUBLIC_API_URL=http://localhost:3001
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_KEYCLOAK_ID=rag-web
AUTH_KEYCLOAK_SECRET=your-keycloak-client-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/rag-platform
