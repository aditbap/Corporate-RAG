# Production values for infra/docker/docker-compose.deploy.yml.
#   cp .env.production.example .env.production   (never commit the copy)
# Generate secrets with:  openssl rand -hex 24

# ---- Public hostnames (DNS A records -> this server) ----
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=you@example.com

# ---- Infrastructure secrets (must be unique; weak defaults make the API refuse to start) ----
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=rag-platform
GRAFANA_ADMIN_PASSWORD=

# ---- Web (Auth.js). AUTH_KEYCLOAK_SECRET comes from infra/keycloak/setup-realm.sh ----
AUTH_SECRET=
AUTH_KEYCLOAK_ID=rag-web
AUTH_KEYCLOAK_SECRET=

# ---- Providers (required: NVIDIA, Cloudflare) ----
NVIDIA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GEMINI_API_KEY=
COHERE_API_KEY=
LLM_PRIMARY_MODEL=@cf/meta/llama-3-8b-instruct
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
EMBEDDING_DIMENSIONS=2048

# ---- Tuning ----
LOG_LEVEL=info
WORKER_CONCURRENCY=5
MAX_FILE_SIZE_MB=100
